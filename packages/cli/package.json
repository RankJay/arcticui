{
  "name": "elasticui",
  "version": "0.1.0",
  "description": "CLI for adding elasticui components to your project",
  "bin": {
    "elasticui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run copy-components",
    "copy-components": "node -e \"require('fs-extra').copySync('src/registry/components', 'dist/registry/components')\"",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "elasticui",
    "cli",
    "components",
    "ui"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "cosmiconfig": "^9.0.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "motion": "^12.23.24",
    "ora": "^7.0.1",
    "prompts": "^2.4.2",
    "ts-morph": "^21.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.6",
    "@types/prompts": "^2.4.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
