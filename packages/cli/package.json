{
  "name": "arcticui-cli",
  "version": "0.3.0",
  "description": "CLI for adding arcticui components to your project",
  "author": {
    "name": "Jay Rank",
    "url": "https://github.com/jayrank"
  },
  "license": "MIT",
  "homepage": "https://github.com/RankJay/arcticui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/RankJay/arcticui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/RankJay/arcticui/issues"
  },
  "keywords": [
    "arcticui",
    "cli",
    "components",
    "ui",
    "react",
    "tailwind",
    "motion",
    "javascript",
    "typescript",
    "paper",
    "shaders"
  ],
  "bin": {
    "arcticui": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run copy-components",
    "copy-components": "node -e \"require('fs-extra').copySync('src/registry/components', 'dist/registry/components')\"",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "cosmiconfig": "^9.0.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "motion": "^12.23.24",
    "ora": "^7.0.1",
    "prompts": "^2.4.2",
    "ts-morph": "^21.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.6",
    "@types/prompts": "^2.4.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}